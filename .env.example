# ============================================================================
# ஜாதகம் AI — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or paste real secrets into frontend/client code.
# ============================================================================

# --- Phase 2: Database -------------------------------------------------
# PostgreSQL connection string (Supabase or self-hosted).
DATABASE_URL=

# Public site URL (used for absolute links in WhatsApp messages, PDFs, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2/9: Auth (Supabase Auth or equivalent) ----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Phase 3: Payment Gateway --------------------------------------------
# Indian payment gateway (e.g. Razorpay). Server-side only — never expose
# PAYMENT_KEY_SECRET or PAYMENT_WEBHOOK_SECRET to the client.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Phase 5: Astrology Calculation Engine -------------------------------
# A deterministic ephemeris library or licensed Vedic astrology API.
# The AI must never be allowed to invent planetary positions — see
# lib/astrology/engine.ts.
ASTROLOGY_API_URL=
ASTROLOGY_API_KEY=

# --- Phase 6: AI Report Engine --------------------------------------------
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Phase 7: PDF Storage --------------------------------------------------
# Supabase Storage or S3-compatible bucket. Reports are served via signed/
# temporary URLs, never permanent public links.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# --- Phase 8: WhatsApp Business Cloud API ----------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Phase 11: Background Job Queue -----------------------------------------
# Redis + BullMQ (or a managed queue). Required so the order pipeline never
# runs inside a single HTTP request.
REDIS_URL=

# --- Admin -------------------------------------------------------------
ADMIN_SESSION_SECRET=

# Public payment key used by the browser checkout widget
NEXT_PUBLIC_PAYMENT_KEY_ID=

# Generic OpenAI-compatible AI endpoint. Keep API key server-side only.
AI_API_BASE_URL=https://api.openai.com/v1

# DB-backed job worker secret. Call /api/jobs/process from a trusted cron/worker.
JOB_SECRET=

# Optional external PDF renderer. If unset, the pipeline produces printable HTML only.
PDF_SERVICE_URL=
